# --- UI tests ---
# URL of the AI-built pipeline, e.g. https://rhombusai.com/workflow/5266
WORKFLOW_URL=

# --- API tests (DevTools > Network > the request's Headers tab) ---
# A GET endpoint that returns this workflow/project as JSON
API_URL=
# Auth: the value after "Authorization: Bearer" (leave blank if the app uses cookies)
API_TOKEN=
# Or the full Cookie header value if the request authenticates with cookies
API_COOKIE=
# A string that must appear in the authenticated response, e.g. the project name
API_EXPECT_IN_BODY=gat-pipeline
